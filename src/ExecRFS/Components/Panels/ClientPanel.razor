@* ClientPanel — configure and control the RFS client process *@
@implements IDisposable

<div class="panel">
    <div class="panel-header">
        <span class="panel-title client">Client</span>
        <span style="display:flex; align-items:center; gap:6px; font-size:11px;">
            <span class="status-dot @DotClass"></span>
            <span style="color:var(--muted);">@ProcessManager.State</span>
        </span>
    </div>

    @* Host *@
    <div class="field">
        <div class="field-label">Server Host</div>
        <input type="text" placeholder="hostname or IP"
               value="@Profile.ClientHost"
               @onchange="OnHostChanged" />
    </div>

    @* Folder *@
    <FolderPicker Label="Sync Folder"
                  Value="@Profile.ClientFolder"
                  ValueChanged="@(v => Profile.ClientFolder = v ?? "")"
                  Placeholder="C:\path\to\folder" />

    @* Port *@
    <div class="field">
        <div class="field-label">Port</div>
        <input type="number" min="1" max="65535"
               value="@Profile.ClientPort"
               @onchange="e => Profile.ClientPort = int.TryParse(e.Value?.ToString(), out var p) ? p : 15782" />
    </div>

    @* Backup Folder *@
    <FolderPicker Label="Backup Folder (optional)"
                  Value="@Profile.ClientBackupFolder"
                  ValueChanged="@(v => Profile.ClientBackupFolder = v)"
                  Placeholder="Leave empty for default (.rfs-backups-NAME, beside the sync folder)" />

    @* Mode *@
    <div class="field">
        <div class="field-label">Mode</div>
        <select value="@((int)Profile.EffectiveMode)"
                @onchange="e => Profile.Mode = (SyncMode)(int.TryParse(e.Value?.ToString(), out var m) ? m : 1)">
            <option value="1">Push (client → server)</option>
            <option value="2">Pull (server → client)</option>
            <option value="3">Two-way (merge)</option>
        </select>
    </div>

    @* Delete + Mirror *@
    <div class="checkbox-row">
        <label class="checkbox-label">
            <input type="checkbox" checked="@Profile.DeleteEnabled"
                   @onchange="e => Profile.DeleteEnabled = (bool)(e.Value ?? false)" />
            Delete Propagation
        </label>
        <label class="checkbox-label">
            <input type="checkbox" checked="@Profile.MirrorDeletes"
                   @onchange="e => Profile.MirrorDeletes = (bool)(e.Value ?? false)" />
            Mirror Deletes
        </label>
    </div>

    @* Archive (protects overwritten / conflicting copies) *@
    <FolderPicker Label="Archive Folder (optional)"
                  Value="@Profile.ArchiveFolder"
                  ValueChanged="@(v => Profile.ArchiveFolder = v)"
                  Placeholder="Leave empty for default (.rfs-archive-NAME, beside the sync folder)" />

    <div class="field-grid" style="margin-bottom:8px;">
        <div class="field">
            <div class="field-label">Archive Keep Days (0 = forever)</div>
            <input type="number" min="0"
                   value="@Profile.ArchiveKeepDays"
                   @onchange="e => Profile.ArchiveKeepDays = int.TryParse(e.Value?.ToString(), out var d) && d >= 0 ? d : 30" />
        </div>
        <div class="field">
            <div class="field-label">Archive Max Size (MB, 0 = no cap)</div>
            <input type="number" min="0"
                   value="@(Profile.ArchiveMaxBytes / 1048576)"
                   @onchange="OnArchiveMaxMbChanged" />
        </div>
    </div>

    @* Block Size + Max Threads *@
    <div class="field-grid" style="margin-bottom:8px;">
        <div class="field">
            <div class="field-label">Block Size</div>
            <select value="@Profile.ClientBlockSize"
                    @onchange="e => Profile.ClientBlockSize = int.TryParse(e.Value?.ToString(), out var v) ? v : 65536">
                <option value="16384">16 KB</option>
                <option value="32768">32 KB</option>
                <option value="65536">64 KB (default)</option>
                <option value="131072">128 KB</option>
                <option value="262144">256 KB</option>
            </select>
        </div>
        <div class="field">
            <div class="field-label">Max Threads</div>
            <select value="@Profile.ClientMaxThreads"
                    @onchange="e => Profile.ClientMaxThreads = int.TryParse(e.Value?.ToString(), out var v) ? v : 1">
                @for (int i = 1; i <= 8; i++)
                {
                    var val = i;
                    <option value="@val">@val</option>
                }
            </select>
        </div>
    </div>

    @* Include / Exclude patterns *@
    <PatternList Label="Include Patterns"
                 Patterns="@Profile.IncludePatterns"
                 PatternsChanged="@(v => Profile.IncludePatterns = v)"
                 Type="include" />

    <PatternList Label="Exclude Patterns"
                 Patterns="@Profile.ExcludePatterns"
                 PatternsChanged="@(v => Profile.ExcludePatterns = v)"
                 Type="exclude" />

    @* Per-thread transfer progress *@
    @if (_activeTransfers.Count > 0)
    {
        <div class="thread-progress">
            <div style="font-size:10px; color:var(--muted); margin-bottom:4px;">Active Transfers</div>
            @foreach (var kv in _activeTransfers.OrderBy(x => x.Key))
            {
                var pct = kv.Value.TotalBytes > 0
                    ? (int)(kv.Value.BytesSent * 100 / kv.Value.TotalBytes)
                    : 0;
                <div>
                    <div class="thread-row">
                        <span style="color:var(--muted);">T@(kv.Key)</span>
                        <span style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                              title="@kv.Value.Path">@System.IO.Path.GetFileName(kv.Value.Path)</span>
                        <span style="color:var(--muted);">@pct%</span>
                    </div>
                    <div class="thread-bar">
                        <div class="thread-bar-fill" style="width:@(pct)%"></div>
                    </div>
                </div>
            }
        </div>
    }

    @* Conflicts / resurrections / overwrites from the last run (emitted after "complete") *@
    @if (_reviewItems.Count > 0)
    {
        <div class="thread-progress">
            <div style="font-size:10px; color:var(--muted); margin-bottom:4px;">Review (@_reviewItems.Count)</div>
            @foreach (var item in _reviewItems)
            {
                <div class="thread-row">
                    <span style="color:var(--muted);">@ReviewLabel(item.Kind)</span>
                    <span style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                          title="@item.Path">@System.IO.Path.GetFileName(item.Path)</span>
                    <span style="color:var(--muted);">@ReviewDetail(item)</span>
                </div>
            }
        </div>
    }

    @* Controls *@
    <div style="display:flex; gap:6px; margin-top:8px;">
        @if (ProcessManager.State == SyncInstanceState.Idle ||
             ProcessManager.State == SyncInstanceState.Stopped ||
             ProcessManager.State == SyncInstanceState.Error)
        {
            <button class="btn btn-start" @onclick="Start">Start Client</button>
        }
        else
        {
            @if (ProcessManager.State == SyncInstanceState.Running)
            {
                <button class="btn btn-pause" @onclick="Pause">Pause</button>
            }
            else if (ProcessManager.State == SyncInstanceState.Paused)
            {
                <button class="btn btn-start" @onclick="Resume">Resume</button>
            }
            <button class="btn btn-stop" @onclick="Stop"
                    disabled="@(ProcessManager.State == SyncInstanceState.Stopping)">Stop</button>
        }
    </div>
</div>

@code {
    [Parameter] public SyncProfile Profile { get; set; } = null!;
    [Parameter] public ProcessManager ProcessManager { get; set; } = null!;

    private readonly Dictionary<int, TransferInfo> _activeTransfers = new();
    private record TransferInfo(string Path, long BytesSent, long TotalBytes, int Thread);

    private readonly List<ReviewItem> _reviewItems = new();
    private record ReviewItem(string Kind, string Path, long? ClientSize, string? ClientMtime,
                              long? ServerSize, string? ServerMtime, string? RenamedTo);

    protected override void OnInitialized()
    {
        ProcessManager.OnProgress += HandleProgress;
        ProcessManager.OnStateChanged += HandleStateChange;
    }

    private void HandleStateChange(SyncInstanceState state)
    {
        // Clear the previous run's review items only once a new run actually begins (Starting),
        // not on the Start click. A no-op Start (the client is still alive and streaming the
        // previous run's review events after "complete") never emits Starting, so it won't wipe
        // items the user is still reading; a failed start still emits Starting, so this stays
        // consistent with ProgressBar's reset.
        if (state == SyncInstanceState.Starting) _reviewItems.Clear();
        InvokeAsync(StateHasChanged);
    }

    private void HandleProgress(ProgressEvent evt)
    {
        switch (evt.Event)
        {
            case "file_start":
                if (evt.Thread.HasValue)
                    _activeTransfers[evt.Thread.Value] =
                        new TransferInfo(evt.Path ?? "", 0, evt.Size ?? 0, evt.Thread.Value);
                break;

            case "file_progress":
                if (evt.Thread.HasValue && _activeTransfers.TryGetValue(evt.Thread.Value, out var existing))
                    _activeTransfers[evt.Thread.Value] = existing with
                    {
                        BytesSent = evt.BytesSent ?? existing.BytesSent,
                        TotalBytes = evt.TotalBytes ?? existing.TotalBytes
                    };
                break;

            case "file_end":
                if (evt.Thread.HasValue)
                    _activeTransfers.Remove(evt.Thread.Value);
                break;

            case "complete":
                _activeTransfers.Clear();
                break;

            case "review":
                // A conflict / resurrection / overwrite. These arrive AFTER "complete", so they
                // must not be cleared there; Start() clears them when the next run begins. The
                // item path reuses evt.Path.
                _reviewItems.Add(new ReviewItem(
                    evt.Kind ?? "", evt.Path ?? "",
                    evt.ClientSize, evt.ClientMtime, evt.ServerSize, evt.ServerMtime, evt.RenamedTo));
                break;
        }
        InvokeAsync(StateHasChanged);
    }

    private string DotClass => ProcessManager.State switch
    {
        SyncInstanceState.Running  => "running",
        SyncInstanceState.Paused   => "paused",
        SyncInstanceState.Error    => "error",
        SyncInstanceState.Starting => "syncing",
        SyncInstanceState.Stopping => "syncing",
        _                          => "idle"
    };

    private void OnHostChanged(ChangeEventArgs e)
        => Profile.ClientHost = e.Value?.ToString() ?? string.Empty;

    private static string ReviewLabel(string kind) => kind switch
    {
        "conflict"     => "CONFLICT",
        "resurrection" => "RESURRECTED",
        "overwrite"    => "OVERWRITE",
        _              => kind.ToUpperInvariant()
    };

    private static string ReviewDetail(ReviewItem item)
    {
        // A kept-both conflict names where the loser was preserved; otherwise show the two sizes.
        if (!string.IsNullOrEmpty(item.RenamedTo))
            return $"kept as {System.IO.Path.GetFileName(item.RenamedTo)}";
        return $"local {FormatSize(item.ClientSize)} / remote {FormatSize(item.ServerSize)}";
    }

    // A size of -1 (paired with an empty mtime) is the CLI's "could not decode" sentinel: show
    // "unknown", never a 0-byte file.
    private static string FormatSize(long? size)
    {
        if (size is null or < 0) return "unknown";
        var b = size.Value;
        if (b < 1024) return $"{b} B";
        if (b < 1024 * 1024) return $"{b / 1024.0:F1} KB";
        return $"{b / 1024.0 / 1024:F1} MB";
    }

    private void Start()  => ProcessManager.Start(Profile);

    // Archive size is stored in bytes but edited in whole MB. Only rewrite when the MB value the
    // user leaves actually differs from what is shown, so tabbing through the field never
    // re-quantizes a byte-precise value set elsewhere; clamp to avoid long overflow on absurd input.
    private void OnArchiveMaxMbChanged(ChangeEventArgs e)
    {
        const long BytesPerMb = 1048576;
        if (!long.TryParse(e.Value?.ToString(), out var mb) || mb < 0) return;
        if (mb == Profile.ArchiveMaxBytes / BytesPerMb) return;   // unchanged in MB terms
        Profile.ArchiveMaxBytes = mb <= long.MaxValue / BytesPerMb ? mb * BytesPerMb : long.MaxValue;
    }
    private void Pause()  => ProcessManager.Pause();
    private void Resume() => ProcessManager.Resume();
    private void Stop()   => ProcessManager.Stop();

    public void Dispose()
    {
        ProcessManager.OnProgress -= HandleProgress;
        ProcessManager.OnStateChanged -= HandleStateChange;
    }
}
